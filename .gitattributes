# Keep reproducibility artifacts in the repository without exceeding ordinary Git blob limits.
# Small manifests, summaries, scripts, figures, and documentation remain normal Git files.
checkpoints/**/*.pt filter=lfs diff=lfs merge=lfs -text
checkpoints/**/*.pth filter=lfs diff=lfs merge=lfs -text
data/**/*.pkl filter=lfs diff=lfs merge=lfs -text
results/raw/**/*.csv filter=lfs diff=lfs merge=lfs -text
results/stats/**/*.csv filter=lfs diff=lfs merge=lfs -text
logs/**/*.log filter=lfs diff=lfs merge=lfs -text
